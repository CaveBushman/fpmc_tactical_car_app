# Generate secrets with: openssl rand -base64 48
SESSION_SECRET=change-me-at-least-32-characters-long
DJANGO_SECRET_KEY=change-me-another-long-random-value
POSTGRES_PASSWORD=change-me-database-password
LIVEKIT_API_KEY=APIfpmc
LIVEKIT_API_SECRET=change-me-livekit-secret
# Public host name behind your TLS proxy (backend and panel)
PUBLIC_HOST=ptt.example.cz
# Public URL the phones use for LiveKit (behind your TLS proxy)
LIVEKIT_PUBLIC_URL=wss://ptt.example.cz
